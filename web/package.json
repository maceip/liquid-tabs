{
  "name": "compact-tab-strip",
  "version": "0.1.0",
  "description": "Safari-style compact glass tab strip for the web",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tabs.css": "./src/tabs.css",
    "./style.css": "./src/style.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5190 --strictPort",
    "capture": "node scripts/capture.mjs"
  },
  "keywords": [
    "tabs",
    "tab-strip",
    "safari",
    "glass",
    "macos",
    "drag-and-drop"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
